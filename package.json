{
	"name": "portifolio-worker",
	"description": "Personal portfolio site — Hono SSR on Cloudflare Workers, projects synced from GitHub.",
	"dependencies": {
		"esbuild": "^0.25.0",
		"hono": "^4.7.0",
		"marked": "^15.0.0",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250901.0",
		"wrangler": "4.56.0"
	},
	"engines": {
		"node": ">=22"
	},
	"private": true,
	"scripts": {
		"build": "node scripts/build-projects.mjs && esbuild src/index.tsx --bundle --format=esm --outfile=dist/index.js --jsx=automatic --jsx-import-source=hono/jsx",
		"cf-typegen": "wrangler types",
		"check": "tsc --noEmit && npm run build && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev"
	},
	"type": "module"
}