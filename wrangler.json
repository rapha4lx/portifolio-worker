{
	"name": "portifolio-worker",
	"compatibility_date": "2025-10-08",
	"main": "./dist/index.js",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "none",
		"html_handling": "auto-trailing-slash"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}