---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const years = [
	{ label: '2024', x: 70, color: '#ff4d63' },
	{ label: '2025', x: 282, color: '#06b889' },
	{ label: '2026', x: 496, color: '#44acd2' },
	{ label: '2027', x: 716, color: '#2f80df' },
	{ label: '2028', x: 924, color: '#7864c9' },
	{ label: '2029', x: 1138, color: '#ffad1f' },
];

const projects = [
	{
		name: 'SessionDB MCP',
		type: 'Open source MCP',
		period: '2025 - 2026',
		color: '#ff4d63',
		path: 'M 70 360 L 140 360 L 214 255 L 465 255',
		dot: { x: 395, y: 255 },
		label: { x: 215, y: 207 },
		circle: { x: 522, y: 255, r: 55 },
		description: 'Durable context layer for model sessions and tool workflows.',
		convergesInto: 'Portfolio Worker',
	},
	{
		name: 'PromoSpy Scraper',
		type: 'Data collection',
		period: '2025 - present',
		color: '#06b889',
		path: 'M 395 255 L 464 145 L 662 145',
		dot: { x: 395, y: 255 },
		label: { x: 468, y: 108 },
		circle: { x: 718, y: 145, r: 55 },
		description: 'Collects current promotion values and product context.',
		convergesInto: 'PromoSpy Notification Service',
	},
	{
		name: 'Datashaper',
		type: 'Ticket worker',
		period: '2025 - 2027',
		color: '#44acd2',
		path: 'M 282 360 L 392 440 L 548 440',
		dot: { x: 392, y: 440 },
		label: { x: 395, y: 400 },
		circle: { x: 602, y: 440, r: 55 },
		description: 'Processes, transforms, and summarizes operational tickets.',
		convergesInto: 'Lovable Ticket UI',
	},
	{
		name: 'Lovable Ticket UI',
		type: 'Product interface',
		period: '2026 - 2028',
		color: '#7864c9',
		path: 'M 282 360 L 496 590 L 828 590',
		dot: { x: 704, y: 590 },
		label: { x: 500, y: 552 },
		circle: { x: 884, y: 590, r: 55 },
		description: 'Interface for ticket management, creation, and AI agents.',
		convergesInto: 'Portfolio Worker',
	},
	{
		name: 'PromoSpy Notification Service',
		type: 'Worker service',
		period: '2027 - 2029',
		color: '#ffad1f',
		path: 'M 704 590 L 780 470 L 1080 470',
		dot: { x: 704, y: 590 },
		label: { x: 782, y: 430 },
		circle: { x: 1134, y: 470, r: 55 },
		description: 'Turns collected promotion data into actionable notifications.',
		convergesInto: 'Portfolio Worker',
	},
	{
		name: 'Portfolio Worker',
		type: 'Landing page',
		period: '2027 - present',
		color: '#2f80df',
		path: 'M 716 360 L 845 275 L 1038 275',
		dot: { x: 716, y: 360 },
		label: { x: 854, y: 235 },
		circle: { x: 1094, y: 275, r: 55 },
		description: 'Public portfolio surface where related projects converge.',
		convergesInto: null,
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="portfolio-page">
			<section class="hero" aria-labelledby="page-title">
				<p class="eyebrow">Portfolio timeline</p>
				<h1 id="page-title">A branch map of projects, experiments, and convergence points.</h1>
				<p class="hero-copy">
					This landing page presents the portfolio as a horizontal project graph. Each branch shows
					when a project started, where it lived in the timeline, and how it connects back into the
					larger system.
				</p>
			</section>

			<section class="timeline-section" aria-labelledby="timeline-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Branch timeline</p>
						<h2 id="timeline-title">Project graph</h2>
					</div>
					<p>
						The layout follows the visual direction from the reference: a main timeline axis, branch
						lines, colored project nodes, and visible convergence between related work.
					</p>
				</div>

				<div class="timeline-card" aria-label="Horizontal branch timeline of portfolio projects">
					<svg class="branch-timeline" viewBox="0 0 1220 660" role="img" aria-labelledby="timeline-svg-title timeline-svg-description">
						<title id="timeline-svg-title">Project branch timeline</title>
						<desc id="timeline-svg-description">
							A horizontal timeline from 2024 to 2029 with branch lines connecting portfolio projects.
						</desc>
						<defs>
							<marker id="arrowhead" markerWidth="12" markerHeight="12" refX="10" refY="6" orient="auto">
								<path d="M 0 0 L 12 6 L 0 12 z" fill="#111111"></path>
							</marker>
						</defs>

						<line class="main-axis" x1="70" y1="360" x2="1190" y2="360" marker-end="url(#arrowhead)"></line>

						{projects.map((project) => (
							<g class="project-branch">
								<path class="branch-line" d={project.path}></path>
								<circle class="branch-dot" cx={project.dot.x} cy={project.dot.y} r="9" fill={project.color}></circle>
							</g>
						))}

						{years.map((year) => (
							<g class="year-marker">
								<text class="year-label" x={year.x + 10} y="330" text-anchor="middle">{year.label}</text>
								<circle cx={year.x} cy="360" r="15" fill={year.color}></circle>
							</g>
						))}

						{projects.map((project) => (
							<g class="project-node">
								<foreignObject x={project.label.x} y={project.label.y} width="270" height="70">
									<div xmlns="http://www.w3.org/1999/xhtml" class="project-note">
										<strong>{project.period}</strong>
										<span>{project.description}</span>
									</div>
								</foreignObject>
								<circle cx={project.circle.x} cy={project.circle.y} r={project.circle.r} fill={project.color}></circle>
								<foreignObject
									x={project.circle.x - project.circle.r + 12}
									y={project.circle.y - project.circle.r + 12}
									width={(project.circle.r - 12) * 2}
									height={(project.circle.r - 12) * 2}
								>
									<div xmlns="http://www.w3.org/1999/xhtml" class="bubble-content">
										<span>{project.type}</span>
										<strong>{project.name}</strong>
									</div>
								</foreignObject>
							</g>
						))}
					</svg>
				</div>

				<div class="project-list" aria-label="Project details">
					{projects.map((project) => (
						<article class="project-card">
							<span class="project-card-type" style={`--project-color: ${project.color};`}>{project.type}</span>
							<h3>{project.name}</h3>
							<p class="project-period">{project.period}</p>
							<p>{project.description}</p>
							{project.convergesInto && <p class="project-convergence">Converges into {project.convergesInto}</p>}
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.portfolio-page {
		width: min(1240px, calc(100% - 2rem));
	}

	.hero {
		padding: 3.5rem 0 2rem;
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.hero h1 {
		max-width: 960px;
		font-size: clamp(2.4rem, 7vw, 5.25rem);
		letter-spacing: -0.07em;
	}

	.hero-copy {
		max-width: 760px;
		color: rgb(var(--gray));
		font-size: clamp(1.05rem, 2vw, 1.35rem);
	}

	.timeline-section {
		margin: 2rem 0 4rem;
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(280px, 0.6fr);
		gap: 2rem;
		align-items: end;
		margin-bottom: 1.5rem;
	}

	.section-heading h2 {
		font-size: clamp(1.8rem, 4vw, 3rem);
		letter-spacing: -0.04em;
	}

	.section-heading p:last-child {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 1rem;
	}

	.timeline-card {
		overflow-x: auto;
		padding: 1rem;
		border: 1px solid rgba(var(--gray), 0.18);
		border-radius: 30px;
		background: #fff;
		box-shadow: var(--box-shadow);
	}

	.branch-timeline {
		display: block;
		width: 100%;
		min-width: 1100px;
		height: auto;
	}

	.main-axis,
	.branch-line {
		fill: none;
		stroke: #111;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.main-axis {
		stroke-width: 5;
	}

	.branch-line {
		stroke-width: 4;
	}

	.branch-dot {
		stroke: #111;
		stroke-width: 1.5;
	}

	.year-label {
		fill: #000;
		font-size: 26px;
		font-weight: 700;
	}

	.project-note {
		display: grid;
		gap: 0.15rem;
		color: rgba(var(--gray-dark), 0.74);
		font-size: 13px;
		line-height: 1.35;
	}

	.project-note strong {
		color: rgb(var(--gray-dark));
		font-size: 12px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.bubble-content {
		display: flex;
		height: 100%;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.4rem;
		color: #fff;
		text-align: center;
		line-height: 1.15;
	}

	.bubble-content span {
		font-size: 11px;
		opacity: 0.82;
	}

	.bubble-content strong {
		font-size: 14px;
		font-weight: 700;
	}

	.project-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.project-card {
		padding: 1rem;
		border: 1px solid rgba(var(--gray), 0.18);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.78);
	}

	.project-card-type {
		display: inline-flex;
		margin-bottom: 0.55rem;
		padding: 0.18rem 0.55rem;
		border-radius: 999px;
		background: var(--project-color);
		color: #fff;
		font-size: 0.72rem;
		font-weight: 700;
	}

	.project-card h3 {
		margin: 0;
		font-size: 1.05rem;
	}

	.project-card p {
		margin: 0.35rem 0 0;
		color: rgb(var(--gray));
		font-size: 0.9rem;
		line-height: 1.45;
	}

	.project-card .project-period,
	.project-card .project-convergence {
		color: rgb(var(--gray-dark));
		font-weight: 700;
	}

	@media (max-width: 900px) {
		.section-heading,
		.project-list {
			grid-template-columns: 1fr;
		}

		.timeline-card {
			border-radius: 20px;
		}
	}
</style>
