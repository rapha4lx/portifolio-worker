---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, OPERATOR } from '../consts';
import projectData from '../data/projects.json';

const CURRENT_YEAR = 2026;

function formatDate(date) {
	return `${date.month} ${date.year}`;
}

function formatRange(project) {
	const start = formatDate(project.start);
	if (!project.completion) return `${start} — running`;
	if (project.start.year === project.completion.year) {
		return `${project.start.month}–${project.completion.month} ${project.completion.year}`;
	}
	return `${start} — ${formatDate(project.completion)}`;
}

const projectNames = new Map(projectData.projects.map((p) => [p.id, p.name]));

// Newest first: active/ongoing work reads at the top of the log.
const projects = [...projectData.projects]
	.map((project) => ({
		...project,
		period: `${formatDate(project.start)} → ${project.completion ? formatDate(project.completion) : 'Present'}`,
		range: formatRange(project),
		isLive: project.status === 'Active',
		exit: project.status === 'Active' ? 'running' : 'exited 0',
		convergesInto: project.references?.convergesInto
			? projectNames.get(project.references.convergesInto)
			: null,
	}))
	.sort((a, b) => Number(b.start.year) - Number(a.start.year));

const startYear = Math.min(...projectData.projects.map((p) => Number(p.start.year)));
const uptimeYears = Math.max(1, CURRENT_YEAR - startYear);
const liveCount = projects.filter((p) => p.isLive).length;

const loaded = ['C', 'Python', 'JavaScript', 'APIs', 'AI agents'];

// ---- git-graph timeline: layout derived entirely from dates ----
const MONTHS = { Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5, Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11 };
const dval = (d) => Number(d.year) + (MONTHS[d.month] ?? 0) / 12;

const PAD_L = 96;
const PAD_R = 130;
const PAD_T = 76;
const YEAR_W = 260;
const LANE_H = 108;
const DIAG = 46;
const MIN_SPAN = 168;

const buildNow = new Date();
const todayVal = buildNow.getFullYear() + buildNow.getMonth() / 12;
const domainStart = Math.floor(Math.min(...projectData.projects.map((p) => dval(p.start))));
const gx = (v) => PAD_L + (v - domainStart) * YEAR_W;
const HEAD_X = gx(todayVal);

// Chronological placement; greedy lane packing, alternating sides of the main line.
const chrono = [...projectData.projects].sort((a, b) => dval(a.start) - dval(b.start));
const lanes = { top: [], bottom: [] };
const placed = new Map();

for (const p of chrono) {
	const active = p.status === 'Active';
	const startX = gx(dval(p.start));
	const rawEndX = active ? HEAD_X : Math.max(gx(dval(p.completion)), startX + MIN_SPAN);
	const endX = active ? HEAD_X : Math.min(rawEndX, HEAD_X);
	const side = lanes.top.length <= lanes.bottom.length ? 'top' : 'bottom';
	const arr = lanes[side];
	let laneIndex = arr.findIndex((freeAt) => freeAt <= startX - 24);
	if (laneIndex === -1) {
		laneIndex = arr.length;
		arr.push(0);
	}
	arr[laneIndex] = endX + 24;
	placed.set(p.id, { p, active, startX, endX, side, laneIndex });
}

const topCount = Math.max(1, lanes.top.length);
const bottomCount = Math.max(1, lanes.bottom.length);
const BASE_Y = PAD_T + topCount * LANE_H;
const svgH = BASE_Y + bottomCount * LANE_H + PAD_T;
const svgW = HEAD_X + PAD_R;

const laneYof = (n) => (n.side === 'top' ? BASE_Y - (n.laneIndex + 1) * LANE_H : BASE_Y + (n.laneIndex + 1) * LANE_H);

const branches = chrono.map((p) => {
	const n = placed.get(p.id);
	const parent = p.references?.convergesInto ? placed.get(p.references.convergesInto) : null;
	const laneY = laneYof(n);
	const baseY = parent ? laneYof(parent) : BASE_Y;
	const splitX = Math.max(n.startX, parent ? parent.startX + DIAG : n.startX);

	if (n.active) {
		const available = HEAD_X - (splitX + DIAG);
		const bubbleX = Math.min(splitX + DIAG + Math.max(42, available * 0.35), HEAD_X - 30);
		return {
			id: p.id, name: p.name, type: p.type, color: p.color, active: true,
			side: n.side, laneY, baseY, splitX, bubbleX, mergeX: null,
			linePath: `M ${splitX} ${baseY} L ${splitX + DIAG} ${laneY} L ${bubbleX} ${laneY}`,
			tailPath: `M ${bubbleX} ${laneY} L ${HEAD_X} ${laneY}`,
		};
	}

	const mergeX = n.endX;
	const bubbleX = (splitX + DIAG + (mergeX - DIAG)) / 2;
	return {
		id: p.id, name: p.name, type: p.type, color: p.color, active: false,
		side: n.side, laneY, baseY, splitX, bubbleX, mergeX,
		linePath: `M ${splitX} ${baseY} L ${splitX + DIAG} ${laneY} L ${mergeX - DIAG} ${laneY} L ${mergeX} ${baseY}`,
		tailPath: null,
	};
});

const yearTicks = [];
for (let y = domainStart; y <= Math.floor(todayVal); y += 1) {
	yearTicks.push({ label: String(y), x: gx(y) });
}

const graphMeta = { domainStart, yearW: YEAR_W, padL: PAD_L, baseY: BASE_Y };
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="console">
			<!-- Signature: the operator as a running service -->
			<section class="unit" aria-labelledby="unit-title">
				<div class="unit-top">
					<span class="mono-label">systemctl status</span>
					<span class="unit-state"><span class="led is-live" aria-hidden="true"></span> active <span>(running)</span></span>
				</div>

				<h1 id="unit-title">
					Rafael Ferro<span class="caret" aria-hidden="true"></span>
				</h1>
				<p class="unit-desc">
					Back-end &amp; full-stack engineer. I build automations, APIs, real-time systems
					and AI agents — a habit picked up keeping game servers alive and taking software apart
					to see how it runs.
				</p>

				<dl class="unit-meta">
					<div>
						<dt>loaded</dt>
						<dd class="loaded">
							{loaded.map((item) => <span class="chip">{item}</span>)}
						</dd>
					</div>
					<div>
						<dt>since</dt>
						<dd>{startYear}</dd>
					</div>
					<div>
						<dt>uptime</dt>
						<dd>{uptimeYears}y</dd>
					</div>
					<div>
						<dt>region</dt>
						<dd>42 Rio</dd>
					</div>
				</dl>

				<div class="unit-actions">
					<a class="btn btn-primary" href="#processes">view processes ↓</a>
					<a class="btn" href="/about">read the log</a>
				</div>
			</section>

			<!-- Project trajectory: a git graph derived from dates -->
			<section class="processes" id="processes" aria-labelledby="processes-title">
				<div class="proc-head">
					<div>
						<span class="mono-label">git log --graph</span>
						<h2 id="processes-title">Trajectory</h2>
					</div>
					<p>
						The <strong>main</strong> line is my path over time, up to today. Each project branches
						off it; completed ones <strong>merge back</strong> in, and anything still active stays
						open, carried forward to <strong>HEAD</strong>.
					</p>
				</div>

				<div class="graph-scroll">
					<svg
						class="graph"
						viewBox={`0 0 ${svgW} ${svgH}`}
						width={svgW}
						height={svgH}
						role="img"
						aria-labelledby="graph-title graph-desc"
						data-domain-start={graphMeta.domainStart}
						data-year-w={graphMeta.yearW}
						data-pad-l={graphMeta.padL}
						data-base-y={graphMeta.baseY}
					>
						<title id="graph-title">Project trajectory graph</title>
						<desc id="graph-desc">
							A git-style graph. Horizontal main line is the timeline from {domainStart} to today;
							projects branch off and merge back when completed.
						</desc>
						<defs>
							<linearGradient id="axis-grad" x1="0" x2="1" y1="0" y2="0">
								<stop offset="0%" stop-color="var(--oxide)"></stop>
								<stop offset="100%" stop-color="var(--oxide-2)"></stop>
							</linearGradient>
						</defs>

						{yearTicks.map((tick) => (
							<g class="tick">
								<line x1={tick.x} y1={PAD_T * 0.6} x2={tick.x} y2={svgH - PAD_T * 0.6}></line>
								<text x={tick.x} y={PAD_T * 0.42} text-anchor="middle">{tick.label}</text>
							</g>
						))}

						<line class="axis-glow" x1={gx(domainStart)} y1={BASE_Y} x2={HEAD_X} y2={BASE_Y}></line>
						<line class="axis" data-main-axis x1={gx(domainStart)} y1={BASE_Y} x2={HEAD_X} y2={BASE_Y}></line>
						<text class="axis-label" x={gx(domainStart)} y={BASE_Y + 28} text-anchor="middle">main</text>

						{branches.map((b) => (
							<g class="branch" style={`--c: ${b.color};`}>
								<path class="branch-glow" d={b.linePath}></path>
								<path class="branch-line" d={b.linePath}></path>
								{b.tailPath && (
									<path class="branch-tail" data-tail data-lane-y={b.laneY} data-bubble-x={b.bubbleX} d={b.tailPath}></path>
								)}
								<circle class="split-dot" cx={b.splitX} cy={b.baseY} r="5"></circle>
								{b.mergeX != null && <circle class="merge-dot" cx={b.mergeX} cy={b.baseY} r="5"></circle>}
								{b.active && (
									<circle class="head-node led is-live" data-head-node data-lane-y={b.laneY} cx={HEAD_X} cy={b.laneY} r="7"></circle>
								)}
								<circle class="node-dot" cx={b.bubbleX} cy={b.laneY} r="9"></circle>
								<foreignObject
									x={b.bubbleX - 82}
									y={b.side === 'top' ? b.laneY - 62 : b.laneY + 18}
									width="164"
									height="46"
								>
									<button
										xmlns="http://www.w3.org/1999/xhtml"
										type="button"
										class:list={['node-btn', b.side === 'top' ? 'is-top' : 'is-bottom']}
										data-project-id={b.id}
										aria-label={`Inspect ${b.name}`}
									>
										<span class="node-type">{b.type}</span>
										<strong>{b.name}</strong>
									</button>
								</foreignObject>
							</g>
						))}

						<g class="head-marker" data-head-marker transform={`translate(${HEAD_X}, 0)`}>
							<line y1={PAD_T * 0.6} y2={svgH - PAD_T * 0.6}></line>
							<text y={svgH - PAD_T * 0.28} text-anchor="middle">HEAD · hoje</text>
						</g>
					</svg>
				</div>

				<p class="proc-summary mono-label">
					{branches.length} units · <span class="live-dot"><span class="led is-live"></span></span> {liveCount} active
				</p>

				<ol class="sr-only">
					{chrono.map((p) => (
						<li>{p.name} — {p.type}, {formatRange(p)}, {p.status}</li>
					))}
				</ol>
			</section>
		</main>

		<dialog class="project-modal" id="project-modal" aria-labelledby="project-modal-title">
			<div class="modal-panel">
				<button class="modal-close" type="button" aria-label="Close details">esc ✕</button>
				<span class="modal-state">
					<span class="led" id="project-modal-led" aria-hidden="true"></span>
					<span id="project-modal-exit"></span>
				</span>
				<span class="modal-id mono-label" id="project-modal-id"></span>
				<h3 id="project-modal-title"></h3>
				<p class="modal-type" id="project-modal-type"></p>
				<p class="modal-description" id="project-modal-description"></p>
				<dl class="modal-meta">
					<div>
						<dt>status</dt>
						<dd id="project-modal-status"></dd>
					</div>
					<div>
						<dt>interval</dt>
						<dd id="project-modal-timing"></dd>
					</div>
					<div>
						<dt>links to</dt>
						<dd id="project-modal-convergence"></dd>
					</div>
				</dl>
				<div class="modal-section">
					<h4 class="mono-label">stack</h4>
					<ul class="tag-list" id="project-modal-stack"></ul>
				</div>
				<div class="modal-section">
					<h4 class="mono-label">highlights</h4>
					<ul class="highlight-list" id="project-modal-highlights"></ul>
				</div>
			</div>
		</dialog>

		<Footer />
	</body>
</html>

<script define:vars={{ projects }}>
	const modal = document.getElementById('project-modal');
	const panel = modal?.querySelector('.modal-panel');
	const closeButton = modal?.querySelector('.modal-close');
	const el = (id) => document.getElementById(id);
	const projectMap = new Map(projects.map((p) => [p.id, p]));

	function renderList(target, items) {
		if (!target) return;
		target.innerHTML = '';
		(items ?? []).forEach((item) => {
			const li = document.createElement('li');
			li.textContent = item;
			target.append(li);
		});
	}

	function openModal(id) {
		const project = projectMap.get(id);
		if (!project || !modal) return;

		panel?.style.setProperty('--project-color', project.color);

		const led = el('project-modal-led');
		led?.classList.toggle('is-live', Boolean(project.isLive));

		el('project-modal-exit').textContent = project.exit;
		el('project-modal-id').textContent = `unit · ${project.id}`;
		el('project-modal-title').textContent = project.name;
		el('project-modal-type').textContent = project.type;
		el('project-modal-description').textContent = project.details;
		el('project-modal-status').textContent = project.status;
		el('project-modal-timing').textContent = project.period;
		el('project-modal-convergence').textContent = project.convergesInto ?? 'standalone unit';
		renderList(el('project-modal-stack'), project.stack);
		renderList(el('project-modal-highlights'), project.highlights);

		modal.showModal();
	}

	document.querySelectorAll('[data-project-id]').forEach((trigger) => {
		trigger.addEventListener('click', () => openModal(trigger.dataset.projectId));
	});
	closeButton?.addEventListener('click', () => modal?.close());
	modal?.addEventListener('click', (event) => {
		if (event.target === modal) modal.close();
	});
</script>

<script>
	// Live HEAD: rescale the "today" end of the graph to the visitor's real date.
	const svg = document.querySelector('.graph');
	if (svg) {
		const domainStart = Number(svg.dataset.domainStart);
		const yearW = Number(svg.dataset.yearW);
		const padL = Number(svg.dataset.padL);
		const now = new Date();
		const nowVal = now.getFullYear() + now.getMonth() / 12;
		const headX = padL + (nowVal - domainStart) * yearW;

		svg.querySelector('[data-main-axis]')?.setAttribute('x2', headX);
		document.querySelector('.axis-glow')?.setAttribute('x2', headX);
		svg.querySelector('[data-head-marker]')?.setAttribute('transform', `translate(${headX}, 0)`);

		svg.querySelectorAll('[data-tail]').forEach((tail) => {
			const laneY = Number(tail.dataset.laneY);
			const bubbleX = Number(tail.dataset.bubbleX);
			tail.setAttribute('d', `M ${bubbleX} ${laneY} L ${headX} ${laneY}`);
		});
		svg.querySelectorAll('[data-head-node]').forEach((node) => {
			node.setAttribute('cx', headX);
		});
	}
</script>

<style>
	.console {
		width: min(920px, calc(100% - 2.5rem));
	}

	/* ---- Signature service unit ---- */
	.unit {
		margin-top: 1.5rem;
		padding: clamp(1.5rem, 4vw, 2.75rem);
		border: 1px solid var(--line-2);
		border-radius: 16px;
		background:
			radial-gradient(30rem 18rem at 100% 0%, var(--oxide-soft), transparent 70%),
			var(--panel);
		box-shadow: var(--box-shadow);
		position: relative;
		overflow: hidden;
	}
	.unit::before {
		content: "";
		position: absolute;
		inset: 0 auto 0 0;
		width: 3px;
		background: linear-gradient(var(--live), var(--oxide));
	}

	.unit-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}
	.unit-state {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--live);
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.unit-state span:last-child {
		color: var(--fg-dim);
	}

	.unit h1 {
		font-weight: 500;
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
	}
	.caret {
		display: inline-block;
		width: 0.55ch;
		height: 1.1em;
		margin-left: 0.25ch;
		transform: translateY(0.12em);
		background: var(--oxide);
		animation: blink 1.1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.unit-desc {
		max-width: 60ch;
		margin: 1.1rem 0 0;
		color: var(--fg-dim);
		font-size: clamp(1rem, 2.2vw, 1.18rem);
		line-height: 1.65;
	}

	.unit-meta {
		display: grid;
		grid-template-columns: 1fr auto auto auto;
		gap: 1.25rem 2rem;
		margin: 2rem 0 0;
		padding: 1.3rem 0 0;
		border-top: 1px solid var(--line);
	}
	.unit-meta dt {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--fg-mute);
		margin-bottom: 0.5rem;
	}
	.unit-meta dd {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 1rem;
		color: var(--fg);
	}
	.loaded {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.chip {
		padding: 0.2rem 0.6rem;
		border: 1px solid var(--oxide-line);
		border-radius: 999px;
		background: var(--oxide-soft);
		color: var(--oxide-2);
		font-size: 0.8rem;
	}

	.unit-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.btn {
		font-family: var(--font-mono);
		font-size: 0.86rem;
		padding: 0.65rem 1.15rem;
		border: 1px solid var(--line-2);
		border-radius: 8px;
		color: var(--fg);
		text-decoration: none;
		transition: border-color 140ms ease, background 140ms ease, transform 140ms ease;
	}
	.btn:hover {
		transform: translateY(-1px);
		border-color: var(--fg-dim);
		color: var(--fg);
	}
	.btn-primary {
		background: var(--oxide);
		border-color: var(--oxide);
		color: #14100e;
		font-weight: 600;
	}
	.btn-primary:hover {
		background: var(--oxide-2);
		border-color: var(--oxide-2);
		color: #14100e;
	}

	/* ---- Trajectory git graph ---- */
	.processes {
		margin-top: 4rem;
	}
	.proc-head {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
		gap: 1.5rem 2rem;
		align-items: end;
		margin-bottom: 1.75rem;
	}
	.proc-head p {
		margin: 0;
		color: var(--fg-dim);
		font-size: 0.95rem;
	}
	.proc-head strong {
		color: var(--fg);
		font-weight: 600;
	}

	/* Full-bleed horizontal scroll container */
	.graph-scroll {
		width: 100vw;
		margin-left: calc(50% - 50vw);
		padding: 0.5rem clamp(1rem, 5vw, 3rem) 1.25rem;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: thin;
		scrollbar-color: var(--line-2) transparent;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
	}
	.graph {
		display: block;
		height: auto;
		margin-inline: auto;
	}

	.tick line {
		stroke: var(--line);
		stroke-width: 1;
	}
	.tick text {
		fill: var(--fg-mute);
		font-family: var(--font-mono);
		font-size: 15px;
		letter-spacing: 0.06em;
	}

	.axis-glow {
		stroke: var(--oxide);
		stroke-width: 11;
		stroke-linecap: round;
		opacity: 0.22;
		filter: blur(5px);
	}
	.axis {
		stroke: url(#axis-grad);
		stroke-width: 5;
		stroke-linecap: round;
	}
	.axis-label {
		fill: var(--oxide-2);
		font-family: var(--font-mono);
		font-size: 13px;
		letter-spacing: 0.08em;
	}

	.branch-line,
	.branch-glow,
	.branch-tail {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.branch-glow {
		stroke: var(--c);
		stroke-width: 9;
		opacity: 0.2;
		filter: blur(4px);
	}
	.branch-line {
		stroke: var(--c);
		stroke-width: 3.5;
	}
	.branch-tail {
		stroke: var(--c);
		stroke-width: 2.5;
		stroke-dasharray: 3 9;
		opacity: 0.7;
	}

	.split-dot {
		fill: var(--c);
	}
	.merge-dot {
		fill: var(--c);
		stroke: var(--void);
		stroke-width: 2;
	}
	.node-dot {
		fill: var(--c);
		stroke: var(--void);
		stroke-width: 3;
	}
	.head-node {
		fill: var(--live);
		stroke: var(--void);
		stroke-width: 3;
		filter: drop-shadow(0 0 6px var(--live));
		animation: nodepulse 2.4s ease-in-out infinite;
	}
	@keyframes nodepulse {
		50% {
			opacity: 0.55;
		}
	}

	.head-marker line {
