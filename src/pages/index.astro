---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const projects = [
	{
		name: 'Portfolio Worker',
		type: 'Landing page',
		period: 'Jan 2026 - present',
		start: 8,
		span: 86,
		lane: 'main',
		description: 'Public portfolio surface for tying projects, writing, and experiments together.',
		convergesInto: null,
	},
	{
		name: 'SessionDB MCP',
		type: 'Open source MCP',
		period: 'Feb 2026 - present',
		start: 18,
		span: 66,
		lane: 'branch',
		description: 'A Model Context Protocol project focused on durable session-backed context.',
		convergesInto: 'Portfolio Worker',
	},
	{
		name: 'PromoSpy Scraper',
		type: 'Data collection',
		period: 'Mar 2026 - present',
		start: 32,
		span: 52,
		lane: 'feature',
		description: 'Scraping pipeline that extracts current promotion values and product context.',
		convergesInto: 'PromoSpy Notification Service',
	},
	{
		name: 'PromoSpy Notification Service',
		type: 'Worker service',
		period: 'Mar 2026 - present',
		start: 46,
		span: 43,
		lane: 'merge',
		description: 'Service layer that turns PromoSpy data into actionable notifications.',
		convergesInto: 'Portfolio Worker',
	},
	{
		name: 'Datashaper',
		type: 'Ticket worker',
		period: 'Apr 2026 - present',
		start: 58,
		span: 35,
		lane: 'experiment',
		description: 'Background worker for processing, transforming, and summarizing tickets.',
		convergesInto: 'Lovable Ticket UI',
	},
	{
		name: 'Lovable Ticket UI',
		type: 'Product interface',
		period: 'Apr 2026 - present',
		start: 64,
		span: 30,
		lane: 'product',
		description: 'User-facing ticket management, creation, and AI-agent interface.',
		convergesInto: 'Portfolio Worker',
	},
];

const markers = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="portfolio-page">
			<section class="hero" aria-labelledby="page-title">
				<p class="eyebrow">Portfolio timeline</p>
				<h1 id="page-title">Projects as a connected system, not isolated cards.</h1>
				<p class="hero-copy">
					A horizontal project map showing when each initiative started, how long it has been active,
					and where one project converges into another. The visual language is inspired by GitHub branch
					and merge graphs.
				</p>
			</section>

			<section class="timeline-section" aria-labelledby="timeline-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Roadmap graph</p>
						<h2 id="timeline-title">Project convergence timeline</h2>
					</div>
					<p>
						Each bar represents project duration. Merge labels show where knowledge, code, or product
						ideas feed into another initiative.
					</p>
				</div>

				<div class="timeline-shell" aria-label="Horizontal portfolio project timeline">
					<div class="timeline-axis" aria-hidden="true">
						{markers.map((marker) => <span>{marker}</span>)}
					</div>

					<div class="timeline-rows">
						{projects.map((project) => (
							<article class={`timeline-row lane-${project.lane}`}>
								<div class="project-meta">
									<span class="project-type">{project.type}</span>
									<h3>{project.name}</h3>
									<p>{project.period}</p>
								</div>
								<div class="project-track">
									<div
										class="project-bar"
										style={`--start: ${project.start}; --span: ${project.span};`}
									>
										<span class="commit-dot start-dot" aria-hidden="true"></span>
										<span class="bar-label">{project.description}</span>
										<span class="commit-dot end-dot" aria-hidden="true"></span>
									</div>
									{project.convergesInto && (
										<div class="merge-note" style={`--merge: ${project.start + project.span};`}>
											<span aria-hidden="true">↳</span> converges into <strong>{project.convergesInto}</strong>
										</div>
									)}
								</div>
							</article>
						))}
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.portfolio-page {
		width: min(1180px, calc(100% - 2rem));
	}

	.hero {
		padding: 3.5rem 0 2rem;
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.hero h1 {
		max-width: 920px;
		font-size: clamp(2.4rem, 8vw, 5.8rem);
		letter-spacing: -0.07em;
	}

	.hero-copy {
		max-width: 760px;
		color: rgb(var(--gray));
		font-size: clamp(1.05rem, 2vw, 1.35rem);
	}

	.timeline-section {
		margin: 2rem 0 4rem;
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(260px, 0.6fr);
		gap: 2rem;
		align-items: end;
		margin-bottom: 1.5rem;
	}

	.section-heading h2 {
		font-size: clamp(1.8rem, 4vw, 3rem);
		letter-spacing: -0.04em;
	}

	.section-heading p:last-child {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 1rem;
	}

	.timeline-shell {
		overflow-x: auto;
		padding: 1rem;
		border: 1px solid rgba(var(--gray), 0.2);
		border-radius: 28px;
		background:
			linear-gradient(90deg, rgba(var(--gray-light), 0.55) 1px, transparent 1px) 284px 0 / calc((100% - 284px) / 5) 100% no-repeat,
			linear-gradient(180deg, #fff, rgba(var(--gray-light), 0.38));
		box-shadow: var(--box-shadow);
	}

	.timeline-axis,
	.timeline-row {
		display: grid;
		grid-template-columns: 260px minmax(720px, 1fr);
		gap: 1.5rem;
	}

	.timeline-axis {
		padding: 0 1rem 0.75rem;
		color: rgba(var(--gray), 0.85);
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.timeline-axis::before {
		content: 'Project';
	}

	.timeline-axis span {
		display: inline-block;
		width: calc(100% / 6);
	}

	.timeline-axis span:first-child {
		margin-left: 0;
	}

	.timeline-axis > span:first-of-type {
		grid-column: 2;
	}

	.timeline-row {
		position: relative;
		min-height: 118px;
		padding: 1rem;
		border-top: 1px solid rgba(var(--gray), 0.16);
	}

	.project-meta {
		align-self: center;
	}

	.project-type {
		display: inline-flex;
		margin-bottom: 0.35rem;
		padding: 0.2rem 0.55rem;
		border: 1px solid rgba(var(--gray), 0.24);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.72);
		color: rgb(var(--gray));
		font-size: 0.75rem;
		font-weight: 700;
	}

	.project-meta h3 {
		margin: 0;
		font-size: 1.05rem;
	}

	.project-meta p {
		margin: 0.25rem 0 0;
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}

	.project-track {
		position: relative;
		align-self: center;
		height: 78px;
	}

	.project-track::before {
		content: '';
		position: absolute;
		top: 30px;
		left: 0;
		right: 0;
		height: 2px;
		background: rgba(var(--gray), 0.18);
	}

	.project-bar {
		position: absolute;
		top: 13px;
		left: calc(var(--start) * 1%);
		width: calc(var(--span) * 1%);
		min-width: 160px;
		padding: 0.55rem 0.9rem;
		border: 1px solid rgba(var(--gray-dark), 0.16);
		border-radius: 999px;
		background: rgb(var(--gray-dark));
		color: #fff;
		font-size: 0.88rem;
		line-height: 1.35;
		box-shadow: 0 12px 30px rgba(var(--gray-dark), 0.16);
	}

	.commit-dot {
		position: absolute;
		top: 50%;
		width: 0.7rem;
		height: 0.7rem;
		border: 3px solid #fff;
		border-radius: 50%;
		background: var(--accent);
		transform: translateY(-50%);
		box-shadow: 0 0 0 2px rgba(var(--gray-dark), 0.16);
	}

	.start-dot {
		left: 0.55rem;
	}

	.end-dot {
		right: 0.55rem;
	}

	.bar-label {
		display: block;
		padding: 0 0.9rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.merge-note {
		position: absolute;
		top: 52px;
		left: min(calc(var(--merge) * 1%), calc(100% - 260px));
		max-width: 260px;
		padding-left: 1.2rem;
		color: rgb(var(--gray));
		font-size: 0.85rem;
		line-height: 1.3;
	}

	.merge-note::before {
		content: '';
		position: absolute;
		left: 0.32rem;
		bottom: 100%;
		width: 1.6rem;
		height: 1.85rem;
		border-left: 2px solid var(--accent);
		border-bottom: 2px solid var(--accent);
		border-bottom-left-radius: 16px;
	}

	.merge-note strong {
		color: rgb(var(--gray-dark));
	}

	.lane-branch .project-bar {
		background: #1f6feb;
	}

	.lane-feature .project-bar {
		background: #8250df;
	}

	.lane-merge .project-bar {
		background: #1a7f37;
	}

	.lane-experiment .project-bar {
		background: #bf8700;
	}

	.lane-product .project-bar {
		background: #cf222e;
	}

	@media (max-width: 820px) {
		.section-heading {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}

		.timeline-shell {
			border-radius: 20px;
		}
	}
</style>
