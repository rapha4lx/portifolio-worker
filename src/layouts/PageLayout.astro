---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	eyebrow?: string;
}

const { title, description, image, eyebrow = 'cat ~/about.md' } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
		<style>
			main {
				width: min(760px, calc(100% - 2.5rem));
				margin: 0 auto;
				padding: 3rem 0 4rem;
			}

			.page-header {
				margin-bottom: 2.5rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid var(--line);
			}

			.page-header .mono-label {
				display: block;
				margin-bottom: 0.85rem;
			}

			.page-header h1 {
				margin-bottom: 0.75rem;
			}

			.page-header p {
				margin: 0;
				color: var(--fg-dim);
				max-width: 62ch;
			}

			.prose {
				color: var(--fg-dim);
				font-size: 1.05rem;
			}

			.prose :global(p) {
				margin-bottom: 1.6em;
			}

			.prose :global(p:first-of-type)::first-letter {
				float: left;
				font-family: var(--font-display);
				font-weight: 700;
				font-size: 3.4rem;
				line-height: 0.8;
				padding: 0.1em 0.14em 0 0;
				color: var(--oxide);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<span class="mono-label">{eyebrow}</span>
				<h1>{title}</h1>
				<p>{description}</p>
			</section>
			<div class="prose">
				<slot />
			</div>
		</main>
		<Footer />
	</body>
</html>
