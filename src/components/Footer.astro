---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="sig">
			<span class="mono-label">operator</span>
			<p>Rafael Ferro — back-end &amp; full-stack engineer</p>
		</div>
		<nav class="footer-links" aria-label="Links">
			<a href="https://github.com/" target="_blank" rel="noopener">github</a>
			<a href="/about">about</a>
			<a href="mailto:rapha4.lx@gmail.com">email</a>
		</nav>
		<p class="uptime mono-label">© {today.getFullYear()} · built &amp; maintained solo</p>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--line);
		background: linear-gradient(180deg, transparent, var(--panel));
	}
	.footer-inner {
		width: min(var(--container), calc(100% - 2.5rem));
		margin: 0 auto;
		padding: 2rem 0 3rem;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem 2rem;
	}
	.sig p {
		margin: 0.35rem 0 0;
		color: var(--fg);
		font-size: 0.95rem;
	}
	.footer-links {
		display: flex;
		gap: 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}
	.footer-links a {
		color: var(--fg-dim);
		text-decoration: none;
	}
	.footer-links a:hover {
		color: var(--oxide-2);
	}
	.uptime {
		margin: 0;
		letter-spacing: 0.1em;
	}
</style>
