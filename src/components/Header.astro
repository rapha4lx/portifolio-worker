---
import HeaderLink from './HeaderLink.astro';
import { OPERATOR } from '../consts';
---

<header>
	<nav>
		<a class="brand" href="/">
			<span class="prompt">~/</span>{OPERATOR}
		</a>
		<div class="internal-links">
			<HeaderLink class="header-link" href="/">home</HeaderLink>
			<HeaderLink class="header-link" href="/about">about</HeaderLink>
		</div>
		<div class="online" aria-label="Status: online">
			<span class="led is-live" aria-hidden="true"></span>
			<span>online</span>
		</div>
		<button
			class="theme-toggle"
			aria-label="Toggle theme"
			aria-pressed="false"
			id="theme-toggle"
		>
			<span class="sr-only">Toggle theme</span>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path></svg>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
		</button>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: color-mix(in srgb, var(--void), transparent 12%);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
	}
	[data-theme="light"] header {
		background: color-mix(in srgb, var(--void), transparent 8%);
		backdrop-filter: blur(12px);
	}
	nav {
		width: min(var(--container), calc(100% - 2.5rem));
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 3.25rem;
		font-family: var(--font-mono);
		font-size: 0.86rem;
	}
	.brand {
		color: var(--fg);
		text-decoration: none;
		font-weight: 500;
		letter-spacing: -0.01em;
	}
	.brand .prompt {
		color: var(--oxide);
	}
	.internal-links {
		display: flex;
		gap: 0.35rem;
	}
	nav :global(a.header-link) {
		padding: 0.35rem 0.65rem;
		color: var(--fg-dim);
		text-decoration: none;
		border-radius: 6px;
		transition: color 140ms ease, background 140ms ease;
	}
	nav :global(a.header-link:hover) {
		color: var(--fg);
		background: var(--panel-2);
	}
	nav :global(a.header-link.active) {
		color: var(--oxide-2);
	}
	.online {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--fg-dim);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
	}
	@media (max-width: 520px) {
		.online span:last-child {
			display: none;
		}
	}
</style>
<script>
	function initThemeToggle() {
		const btn = document.getElementById('theme-toggle');
		if (!btn) return;
		const html = document.documentElement;
		const current = html.dataset.theme;
		btn.setAttribute('aria-pressed', current === 'light');
		btn.addEventListener('click', () => {
			const next = html.dataset.theme === 'light' ? 'dark' : 'light';
			html.dataset.theme = next;
			localStorage.setItem('theme', next);
			btn.setAttribute('aria-pressed', next === 'light');
		});
		window.addEventListener('storage', (e) => {
			if (e.key === 'theme' && e.newValue) {
				html.dataset.theme = e.newValue;
				btn.setAttribute('aria-pressed', e.newValue === 'light');
			}
		});
	}
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initThemeToggle);
	} else {
		initThemeToggle();
	}
</script>
