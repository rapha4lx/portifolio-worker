---
import HeaderLink from './HeaderLink.astro';
import { OPERATOR } from '../consts';
---

<header>
	<nav>
		<a class="brand" href="/">
			<span class="prompt">~/</span>{OPERATOR}
		</a>
		<div class="internal-links">
			<HeaderLink class="header-link" href="/">home</HeaderLink>
			<HeaderLink class="header-link" href="/about">about</HeaderLink>
		</div>
		<div class="online" aria-label="Status: online">
			<span class="led is-live" aria-hidden="true"></span>
			<span>online</span>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: color-mix(in srgb, var(--void), transparent 12%);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
	}
	nav {
		width: min(1080px, calc(100% - 2.5rem));
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 3.25rem;
		font-family: var(--font-mono);
		font-size: 0.86rem;
	}
	.brand {
		color: var(--fg);
		text-decoration: none;
		font-weight: 500;
		letter-spacing: -0.01em;
	}
	.brand .prompt {
		color: var(--oxide);
	}
	.internal-links {
		display: flex;
		gap: 0.35rem;
	}
	nav :global(a.header-link) {
		padding: 0.35rem 0.65rem;
		color: var(--fg-dim);
		text-decoration: none;
		border-radius: 6px;
		transition: color 140ms ease, background 140ms ease;
	}
	nav :global(a.header-link:hover) {
		color: var(--fg);
		background: var(--panel-2);
	}
	nav :global(a.header-link.active) {
		color: var(--oxide-2);
	}
	.online {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--fg-dim);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
	}
	@media (max-width: 520px) {
		.online span:last-child {
			display: none;
		}
	}
</style>
