# Directus CMS — environment template (copy to .env and fill real values)
#
# Required by the Directus server itself:
#   SECRET         — long random string; generate with `openssl rand -base64 48`
#   ADMIN_EMAIL / ADMIN_PASSWORD — bootstraps the admin user on first start
#   DB_CLIENT      — sqlite3 (backend is SQLite, single file)
#   DB_FILENAME    — path INSIDE the container, must stay /directus/database/data.db
#   PUBLIC_URL     — public origin of this instance (used for redirects/URL generation)

SECRET=change-me-openssl-rand-base64-48
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
DB_CLIENT=sqlite3
DB_FILENAME=/directus/database/data.db
PUBLIC_URL=https://cms.rafaelferro.dev/

# Traefik BasicAuth guard for the admin SPA routes (/admin, /login, ...).
# Generate with:  htpasswd -nbB <user> '<password>'
#   -> outputs  user:$2y$05$...   (the part AFTER the first colon is BCRYPT_HASH)
# CRITICAL compose detail: every `$` in the hash must be doubled (`$$`) because
# Compose interpolates `.env` values. Example stored here uses $$2y$$05$$... —
# copy your real hash and replace every `$` with `$$` (or run this from the
# deploy dir:  BCRYPT_HASH=$(htpasswd -nbB "$BASIC_AUTH_USER" '<password>' | cut -d: -f2 | sed 's/\$/$$/g') )
BASIC_AUTH_USER=admin
BCRYPT_HASH=$$2y$$05$$replace-with-htpasswd-bcrypt-hash

# GitHub token used by the Directus "Publish" flow to dispatch
# .github/workflows/publish.yml (workflow_dispatch).
# Fine-grained PAT scoped to this repo with Actions: write.
GITHUB_WORKFLOW_TOKEN=github_pat_xxx

# Base URL used by the admin scripts (seed / permissions / create-flow)
DIRECTUS_URL=https://cms.rafaelferro.dev/